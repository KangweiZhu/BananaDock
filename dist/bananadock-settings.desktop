[Desktop Entry]
Type=Application
Name=BananaDock Settings
GenericName=Dock Settings
Comment=Configure the BananaDock dock
# Rewritten by the install step to the absolute path of the installed binary.
Exec=/usr/bin/bananadock --settings
Icon=configure
Terminal=false
Categories=Settings;DesktopSettings;
# The same declarations as bananadock.desktop, and they are not optional here.
#
# KWin decides what a client may use by tracing its process back to a desktop
# entry -- by executable path, ignoring arguments. Two entries naming the same
# binary are both candidates, so an entry without these silently costs the dock
# its window list: it falls back to driving a KWin script and nothing reports
# an error.
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
